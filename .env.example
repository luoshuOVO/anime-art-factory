# ==============================================================================
# 二次元自动化生图工坊 · 环境变量模板
# 用法：cp .env.example .env  然后按提示填完「必填项」即可启动
# 严禁把填好密钥的 .env 上传到公开仓库！
# ==============================================================================

# ------------------------------------------------------------------------------
# 一、基础端口与监听地址
# ------------------------------------------------------------------------------
# 本机/内网访问或走 Nginx/Cloudflare Tunnel 反代保持 127.0.0.1；
# 如果想直接通过服务器 IP 访问，改成 0.0.0.0（建议配好防火墙或反代鉴权）
BIND_IP=127.0.0.1
STUDIO_PORT=29091
FACTORY_PORT=28096
TZ=Asia/Shanghai

# ------------------------------------------------------------------------------
# 二、【必填】AI 模型接口（任意 OpenAI 兼容端点，如 OpenAI/DeepSeek/OneAPI/NewAPI/硅基流动）
# ------------------------------------------------------------------------------
# 文本模型用来写提示词和漫画脚本；视觉模型用来给画完的图打分拦废图、看参考图二创
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-请替换成你自己的APIKey
LLM_TEXT_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 三、【必填】Colab GPU Studio 登录与安全密钥（请全部替换成随机字符串）
# 可在终端运行：python3 -c "import secrets; print(secrets.token_urlsafe(32))" 生成
# ------------------------------------------------------------------------------
STUDIO_IMAGE=ghcr.io/naoya666/colab-comfy-studio:latest
ENVIRONMENT=production
# 你的 Colab Studio 访问地址（本地调试可填 http://127.0.0.1:29091）
SITE_URL=http://127.0.0.1:29091
STUDIO_PASSWORD=请设置Studio网页登录密码
ENCRYPTION_KEY=请填入32位以上随机密钥用于加密存储Google授权
SESSION_SECRET=请填入32位以上随机Session密钥
# Studio 与画图工坊内部通信的 API Token（两边共用这一个值，直接填随机字符串即可）
STUDIO_API_TOKEN=请填入32位以上随机API_Token
# 同 docker-compose 内默认直连即可，无需修改
STUDIO_BASE=http://colab-comfy-studio:8788

# ------------------------------------------------------------------------------
# 四、【必填】Colab GPU 与 Google OAuth 配置
# 说明：打开 Studio 网页后需要绑定自己的 Google 账号 & Colab 算力（详见 README）
# ------------------------------------------------------------------------------
GPU_ENABLED=true
GPU_REAL_ENABLED=true
GPU_STORAGE=drive
STUDIO_TIMEZONE=Asia/Shanghai
GPU_DAILY_UNITS=200
GPU_UNIT_RATE=1.0
GPU_CREATE_RETRIES=25
GPU_CREATE_TIMEOUT_SECONDS=120
# Google Cloud Console 创建 OAuth 客户端后填入（重定向 URI 填 ${SITE_URL}/api/gpu/oauth/callback）
GPU_GOOGLE_CLIENT_ID=
GPU_GOOGLE_CLIENT_SECRET=
GPU_GOOGLE_REDIRECT_URI=http://127.0.0.1:29091/api/gpu/oauth/callback

# ------------------------------------------------------------------------------
# 五、画图工坊默认策略（按需微调，默认即可直接用）
# ------------------------------------------------------------------------------
# 工作流预设：
#   单 MOSS 画师（推荐新手先用，快且省 CU）：moss-image-sft-t2i / 1.0.0 / moss-image-sft
#   Krea-2+MOSS 双画师（需先传好 LoRA 并在 Studio 发布）：krea2-moss-dual-t2i / 1.1.1 / krea2-moss-dual
DEFAULT_WORKFLOW_KEY=moss-image-sft-t2i
DEFAULT_WORKFLOW_VERSION=1.0.0
DEFAULT_MODEL_ID=moss-image-sft
# Colab 显卡类型：L4 / T4 / A100（推荐 L4，性价比最高）
DEFAULT_GPU_ACCELERATOR=L4
# 每日巡航默认张数 & AI 质检最低及格分（1~10 分，低于此分自动丢弃废图）
DEFAULT_DAILY_COUNT=16
DEFAULT_QUALITY_THRESHOLD=7.5

# ------------------------------------------------------------------------------
# 六、【全部选填】外部图床 & 网页抓取（不填也能直接跑！默认存本地 ./data/outputs/）
# ------------------------------------------------------------------------------
# 如果你的画图工坊有外网域名，可填在这里方便返回完整图片链接，留空返回相对路径 /outputs/...
PUBLIC_BASE_URL=

# 若已自建 CloudFlare-ImgBed 图床，填下面 4 项即可自动上传图床；留空自动走本地目录
IMGBED_BASE=
IMGBED_PUBLIC_BASE=
IMGBED_AUTH_CODE=
IMGBED_MANAGE_TOKEN=
IMGBED_UPLOAD_CHANNEL=cfr2

# 若已自建 Crawl4AI，填下面 2 项提升复杂网页抓取效果；留空会使用内置轻量网页抓取兜底
CRAWL4AI_BASE=
CRAWL4AI_API_TOKEN=
